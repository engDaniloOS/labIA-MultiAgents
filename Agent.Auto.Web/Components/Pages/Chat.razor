@page "/"
@using System.Diagnostics
@using System.Text.RegularExpressions
@using Agent.Auto.Web.Models
@using Agent.Auto.Web.Services
@using Markdig
@implements IAsyncDisposable
@inject OrchestratorClient Orchestrator
@inject IJSRuntime JS

<PageTitle>Agentes de veículos</PageTitle>

<div class="app">
    <header class="topbar">
        <span class="brand">Agentes de veículos</span>
        <span class="conversation">Conversa: @(conversationId ?? "(nova)")</span>
        <button type="button" class="ghost" @onclick="NewConversation" disabled="@busy">Nova conversa</button>
    </header>

    <div class="body">
        <aside class="sidebar">
            <div class="sidebar-title">
                <span>Quem responde</span>
                <button type="button" class="link" @onclick="LoadAgentsAsync" disabled="@busy">Atualizar</button>
            </div>

            <button type="button" class="agent-card @(selectedAgent == "" ? "selected" : "")"
                    @onclick='() => Select("")' disabled="@busy">
                <span class="dot auto"></span>
                <span class="agent-info">
                    <strong>Automático</strong>
                    <small>O roteador escolhe o agente pelo assunto</small>
                </span>
            </button>

            @foreach (var agent in agents)
            {
                <button type="button" class="agent-card @(selectedAgent == agent.Key ? "selected" : "")"
                        @onclick="() => Select(agent.Key)" disabled="@(busy || !agent.Available)"
                        title="@(agent.Available ? agent.Card?.Description : agent.Error)">
                    <span class="dot @AgentClass(agent.Key) @(agent.Available ? "" : "off")"></span>
                    <span class="agent-info">
                        <strong>@agent.Key</strong>
                        <small>@(agent.Available ? agent.Card?.Name : "indisponível")</small>
                    </span>
                </button>
            }

            @if (agentsError is not null)
            {
                <p class="error">@agentsError</p>
            }
        </aside>

        <main class="chat">
            <div class="messages" @ref="messagesPanel">
                @if (messages.Count == 0)
                {
                    <div class="welcome">
                        <h2>Como posso ajudar?</h2>
                        <p>Fale de comprar, vender ou financiar um veículo. No modo Automático, o roteador decide qual agente atende.</p>
                        <div class="chips">
                            @foreach (var suggestion in suggestions)
                            {
                                <button type="button" class="chip" @onclick="() => SendAsync(suggestion)" disabled="@busy">@suggestion</button>
                            }
                        </div>
                    </div>
                }

                @foreach (var message in messages)
                {
                    <div class="row @message.Role">
                        <div class="avatar @AgentClass(message.AgentKey)">@Initial(message)</div>
                        <div class="bubble">
                            <div class="who">
                                <strong>@(message.Role == "user" ? "Você" : message.AgentKey ?? "Assistente")</strong>
                                @if (message.Meta is not null)
                                {
                                    <span class="meta">@message.Meta</span>
                                }
                            </div>

                            @if (message.Role == "user")
                            {
                                <div class="text plain">@message.Text</div>
                            }
                            else if (message.Text.Length > 0)
                            {
                                <div class="text">@RenderMarkdown(message.Text)</div>
                            }
                            else if (message.Error is null)
                            {
                                <div class="typing"><span></span><span></span><span></span></div>
                            }

                            @if (message.Error is not null)
                            {
                                <div class="error">@message.Error</div>
                            }

                            @if (message.Timing is not null)
                            {
                                <div class="timing">@message.Timing</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <form class="composer" @onsubmit="() => SendAsync(null)">
                <input @bind="input" @bind:event="oninput" disabled="@busy"
                       placeholder="Digite sua mensagem" autocomplete="off" />
                <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(input))">Enviar</button>
            </form>
        </main>
    </div>
</div>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private static readonly string[] suggestions =
    [
        "Quero um carro econômico para a cidade, até 80 mil",
        "Preciso vender meu carro, por onde começo?",
        "Como funciona a entrada mínima do financiamento?"
    ];

    private sealed class MessageView(string role, string text)
    {
        public string Role { get; } = role;
        public string Text { get; set; } = text;
        public string? AgentKey { get; set; }
        public string? Meta { get; set; }
        public string? Timing { get; set; }
        public string? Error { get; set; }
    }

    private readonly List<MessageView> messages = [];
    private readonly CancellationTokenSource disposing = new();

    private ElementReference messagesPanel;
    private IJSObjectReference? module;
    private bool scrollPending;
    private bool forceScroll;

    private IReadOnlyList<AgentDto> agents = [];
    private string? agentsError;
    private string selectedAgent = "";
    private string? conversationId;
    private string input = "";
    private bool busy;

    protected override Task OnInitializedAsync() => LoadAgentsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Chat.razor.js");

        if (scrollPending && module is not null)
        {
            scrollPending = false;
            await module.InvokeVoidAsync("scrollToEnd", messagesPanel, forceScroll);
            forceScroll = false;
        }
    }

    private void Select(string key) => selectedAgent = key;

    private async Task LoadAgentsAsync()
    {
        try
        {
            agents = await Orchestrator.GetAgentsAsync(disposing.Token);
            agentsError = null;
        }
        catch (OrchestratorException ex)
        {
            agentsError = ex.Message;
        }
    }

    private void NewConversation()
    {
        messages.Clear();
        conversationId = null;
    }

    // Quando vem de uma sugestão, usa o texto dela; quando vem do formulário, usa o que foi digitado.
    private async Task SendAsync(string? suggestion)
    {
        var text = (suggestion ?? input).Trim();
        if (busy || text.Length == 0)
            return;

        input = "";
        busy = true;

        messages.Add(new MessageView("user", text));
        var reply = new MessageView("assistant", "");
        messages.Add(reply);
        RequestScroll(force: true);

        var stopwatch = Stopwatch.StartNew();
        long? firstTextMs = null;

        try
        {
            var agent = string.IsNullOrEmpty(selectedAgent) ? null : selectedAgent;

            await foreach (var evt in Orchestrator.StreamChatAsync(text, agent, conversationId, disposing.Token))
            {
                switch (evt)
                {
                    case StartEvent start:
                        conversationId = start.ConversationId;
                        reply.AgentKey = start.Agent;
                        reply.Meta = Describe(start);
                        break;
                    case DeltaEvent delta:
                        firstTextMs ??= stopwatch.ElapsedMilliseconds;
                        reply.Text += delta.Text;
                        break;
                    case ErrorEvent error:
                        reply.Error = error.Message;
                        break;
                }

                // Redesenha a cada evento para o texto aparecer aos poucos.
                RequestScroll(force: false);
                StateHasChanged();
            }

            reply.Timing = firstTextMs is null
                ? null
                : $"1º texto em {firstTextMs / 1000.0:0.0} s · resposta completa em {stopwatch.ElapsedMilliseconds / 1000.0:0.0} s";
        }
        catch (OperationCanceledException)
        {
            // A página foi fechada no meio da resposta.
        }
        catch (Exception ex) when (ex is OrchestratorException or HttpRequestException or IOException)
        {
            reply.Error = ex.Message;
        }
        finally
        {
            busy = false;
            RequestScroll(force: false);
        }
    }

    private void RequestScroll(bool force)
    {
        scrollPending = true;
        forceScroll |= force;
    }

    private static string Describe(StartEvent start) => start switch
    {
        { Agent: null } => $"roteador sem confiança ({start.Confidence:P0}): pediu mais informações",
        { Routed: true } => $"escolhido pelo roteador · confiança {start.Confidence:P0}",
        _ => "escolhido por você"
    };

    private static string AgentClass(string? key) => key?.ToLowerInvariant() switch
    {
        "bank" => "agent-bank",
        "hunter" => "agent-hunter",
        "seller" => "agent-seller",
        _ => "agent-other"
    };

    private static string Initial(MessageView message)
        => message.Role == "user" ? "V" : (message.AgentKey ?? "?")[..1].ToUpperInvariant();

    // As respostas dos agentes vêm em Markdown. HTML cru é desligado, e links com javascript: são neutralizados.
    private static MarkupString RenderMarkdown(string text)
    {
        var html = Markdown.ToHtml(text, MarkdownPipeline);
        html = Regex.Replace(html, "href=\"\\s*javascript:[^\"]*\"", "href=\"#\"", RegexOptions.IgnoreCase);
        html = html.Replace("<a href=", "<a target=\"_blank\" rel=\"noopener noreferrer\" href=");

        return new MarkupString(html);
    }

    public async ValueTask DisposeAsync()
    {
        disposing.Cancel();
        disposing.Dispose();

        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // O circuito já caiu; não há mais o que liberar no navegador.
            }
        }
    }
}
